generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["treatfeedtails"]
}

model PrimaryDogDetails {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tagId            String   @unique(map: "primary_dog_details_tag_id_key") @map("tag_id")
  animalCategory   String   @map("animal_category")
  photoPath        String?  @map("photo_path")
  name             String?
  gender           String?
  age              Int?
  color            String?
  breed            String?
  identifyingMarks String?  @map("identifying_marks")
  notes            String?
  address          String?
  area             String?
  createdDate      DateTime @default(now()) @map("created_date")
  addedBy          String?  @map("added_by")
  updatedDate      DateTime @default(now()) @map("updated_date")
  updatedBy        String?  @map("updated_by")
  healthDetails    SterilizationVaccinationDetails?
  medicalNotes     MedicalNote[]

  @@index([area], map: "primary_dog_details_area_idx")
  @@index([updatedDate(sort: Desc)], map: "primary_dog_details_updated_date_idx")
  @@map("primary_dog_details")
  @@schema("treatfeedtails")
}

model SterilizationVaccinationDetails {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dogId               String   @unique @map("dog_id") @db.Uuid
  sterilizationStatus String   @map("sterilization_status")
  rabies              Boolean  @default(false)
  nineInOne           Boolean  @default(false) @map("nine_in_one")
  vaccinationDate     DateTime? @map("vaccination_date")
  dog                 PrimaryDogDetails @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@map("sterilization_vaccination_details")
  @@schema("treatfeedtails")
}

model MedicalNote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dogId           String   @map("dog_id") @db.Uuid
  medicalCondition String   @map("medical_condition")
  treatmentStatus String   @map("treatment_status")
  treatmentGiven  String   @default("") @map("treatment_given")
  startedDate     DateTime @map("started_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  caretaker       String   @default("")
  vetDetails      String   @default("") @map("vet_details")
  dog             PrimaryDogDetails @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId], map: "medical_notes_dog_id_idx")
  @@map("medical_notes")
  @@schema("treatfeedtails")
}